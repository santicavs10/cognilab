---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Professionals from '../components/Professionals.astro';
import { siteConfig } from '../data/site';
---

<MainLayout
  title={`Equipo de psicólogas y psicopedagogas en Belgrano | ${siteConfig.name}`}
  description="Conocé al equipo interdisciplinario de CogniLab: psicólogas y psicopedagogas en Belgrano, CABA."
>
  <Header />

  <main>
    <Professionals />

  </main>

  <Footer />
</MainLayout>

<style>
  main > :global(#profesionales) {
    padding-top: 2rem;
  }
</style>
