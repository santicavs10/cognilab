---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceBody from '../components/ServiceBody.astro';
import { services, siteConfig } from '../data/site';

const accentColors = [
  'var(--color-primary)',
  'var(--color-secondary-strong)',
  'var(--color-purple)',
  'var(--color-pink)',
  'var(--color-orange)',
  'var(--color-secondary)'
];
---

<MainLayout
  title={`Servicios | ${siteConfig.name}`}
  description="Conocé en detalle los servicios de psicología, psicopedagogía y orientación familiar que ofrece CogniLab."
>
  <Header />

  <main>
    <section class="services-detail section">
      <div class="container">
        <h1 class="page-title" data-reveal>Servicios</h1>
        {services.map((service, i) => (
          <article id={service.slug} class="service-item" style={`--accent: ${accentColors[i % accentColors.length]}`} data-reveal>
            <div class="service-item-header">
              <div class="service-accent-bar"></div>
              <h2>{service.title}</h2>
            </div>

            <div class="service-item-body">
              <ServiceBody service={service} />
            </div>
          </article>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</MainLayout>

<style>
  /* ─── Título ─────────────────────────────────────────── */
  .page-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: var(--color-text);
    margin: 0 0 2.5rem;
    text-align: center;
  }

  /* ─── Service items ──────────────────────────────────── */
  .services-detail {
    padding-top: 2rem;
  }

  .service-item {
    display: grid;
    gap: 2rem;
    scroll-margin-top: 100px;
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    margin-bottom: 2rem;
  }

  .service-item:last-child {
    margin-bottom: 0;
  }

  .service-item-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .service-accent-bar {
    width: 0.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .service-item-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin: 0;
  }

  /* Texto a un ancho de lectura cómodo */
  .service-item-body {
    max-width: 46rem;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 600px) {
    .service-item {
      padding: 1.5rem;
    }
  }
</style>
