---
import { about } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// **texto** -> <strong>texto</strong> (se escapa el HTML antes)
const rich = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<section id="inicio" class="hero section">
  <div class="container hero-blocks">
    {about.map((block, i) => {
      // El primer título es el h1 de la página; los siguientes, h2 con el mismo aspecto
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
        <div class:list={['hero-grid', { 'hero-grid--reverse': i % 2 === 1 }]}>
          <div class="hero-content">
            <Heading class="hero-title" data-reveal>{block.title}</Heading>
            <div class="hero-description" data-reveal>
              {block.paragraphs.map((text) => <p set:html={rich(text)} />)}
            </div>
          </div>

          <div class="hero-card" data-reveal>
            <img
              src={`${base}${block.image}`}
              alt={block.alt}
              width={block.imageWidth}
              height={block.imageHeight}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .hero {
    padding: 2rem 0 5rem;
    scroll-margin-top: 80px;
  }

  .hero-blocks {
    display: grid;
    gap: 4.5rem;
  }

  /* Texto a la izquierda y foto a la derecha; en los bloques pares, al revés (zigzag) */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
  }

  .hero-grid--reverse {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .hero-grid--reverse .hero-card {
    order: -1;
  }

  .hero-content {
    max-width: 640px;
  }

  /* Mismo tamaño que un h2 global: el título se achicó a propósito */
  .hero-title {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 3vw, 3.2rem);
  }

  /* Texto en una tarjeta, con la franja arcoíris de los colores del logo */
  .hero-description {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .hero-description p {
    margin: 0;
  }

  .hero-description p + p {
    margin-top: 0.85rem;
  }

  .hero-description :global(strong) {
    font-weight: 700;
  }

  .hero-description::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: var(--gradient-rainbow);
  }

  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    height: min(60vh, 520px);
    min-height: 320px;
  }

  .hero-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      padding-top: 2rem;
    }

    .hero-blocks {
      gap: 3.5rem;
    }

    .hero-grid,
    .hero-grid--reverse {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* Título → foto → texto en cada bloque: el bloque de texto se "abre" para intercalar la foto */
    .hero-content {
      display: contents;
    }

    .hero-title {
      order: 1;
      margin: 0;
    }

    .hero-card,
    .hero-grid--reverse .hero-card {
      order: 2;
      height: 42vh;
      min-height: 280px;
    }

    .hero-description {
      order: 3;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 3rem 0 4rem;
    }

    .hero-description {
      padding: 1.5rem 1.25rem 1.25rem;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero-card,
    .hero-grid--reverse .hero-card {
      height: 36vh;
      min-height: 240px;
      border-radius: 22px;
    }
  }
</style>
