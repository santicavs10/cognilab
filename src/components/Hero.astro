---
import { siteConfig } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Un párrafo por oración (la descripción también se usa entera como meta descripción)
const paragraphs = siteConfig.description.split(/(?<=\.)\s+/);
---

<section id="inicio" class="hero section">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1 data-reveal>{siteConfig.name}</h1>
      <div class="hero-description" data-reveal>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>

    <div class="hero-card" data-reveal>
      <img
        src={`${base}/images/nuestro-enfoque.jpg`}
        alt="Escritorio de trabajo de CogniLab con materiales de evaluación, juegos didácticos y un cuaderno con el logo"
        width="889"
        height="1333"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 2rem 0 5rem;
    scroll-margin-top: 80px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
  }

  .hero-content {
    max-width: 640px;
  }

  /* Mismo tamaño que un h2 global: el título se achicó a propósito */
  .hero-content h1 {
    font-size: clamp(2rem, 3vw, 3.2rem);
  }

  /* Texto del enfoque en una tarjeta, con la franja arcoíris de los colores del logo */
  .hero-description {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .hero-description p {
    margin: 0;
  }

  .hero-description p + p {
    margin-top: 0.85rem;
  }

  .hero-description::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: var(--gradient-rainbow);
  }

  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    height: min(60vh, 520px);
    min-height: 320px;
  }

  .hero-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 2rem;
    }

    /* Título → foto → texto: el bloque de texto se "abre" para intercalar la foto */
    .hero-grid {
      gap: 1.5rem;
    }

    .hero-content {
      display: contents;
    }

    .hero-content h1 {
      order: 1;
      margin: 0;
    }

    .hero-card {
      order: 2;
      height: 42vh;
      min-height: 280px;
    }

    .hero-description {
      order: 3;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 3rem 0 4rem;
    }

    .hero-description {
      padding: 1.5rem 1.25rem 1.25rem;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero-card {
      height: 36vh;
      min-height: 240px;
      border-radius: 22px;
    }
  }
</style>
