---
import { about } from '../data/site';
import { rich } from '../utils/rich';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="inicio" class="hero section">
  <div class="container hero-blocks">
    {about.map((block, i) => {
      // El primer título es el h1 de la página; los siguientes, h2 con el mismo aspecto
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
        <div class:list={['hero-grid', { 'hero-grid--reverse': i % 2 === 1 }]}>
          <div class="hero-content">
            <Heading class="hero-title" data-reveal>{block.title}</Heading>
            <div class="hero-description" data-reveal>
              {block.paragraphs.map((text) => <p set:html={rich(text)} />)}
            </div>
          </div>

          <div class="hero-card" data-reveal>
            <img
              src={`${base}${block.image}`}
              alt={block.alt}
              width={block.imageWidth}
              height={block.imageHeight}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  // Justificado "suave" en celular: los renglones que al justificarse quedarían con espacios muy
  // abiertos terminan con un <br> y quedan alineados a la izquierda (CSS no justifica una línea
  // que termina en salto forzado). El resto del párrafo sigue justificado.
  const MOBILE = window.matchMedia('(max-width: 600px)');
  const MAX_EXTRA_EM = 0.7; // espacio extra máximo por hueco entre palabras, en em (más que eso se ve "agujereado")
  const paragraphs = [...document.querySelectorAll<HTMLParagraphElement>('.hero-description p')];
  const original = new Map(paragraphs.map((p) => [p, p.innerHTML]));

  type Word = { node: Text; end: number; rect: DOMRect };

  const wordsOf = (p: HTMLElement): Word[] => {
    const words: Word[] = [];
    const walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT);
    const range = document.createRange();
    for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
      for (const m of node.data.matchAll(/\S+/g)) {
        range.setStart(node, m.index!);
        range.setEnd(node, m.index! + m[0].length);
        const rects = range.getClientRects();
        if (rects.length) words.push({ node, end: m.index! + m[0].length, rect: rects[rects.length - 1] });
      }
    }
    return words;
  };

  const balance = () => {
    paragraphs.forEach((p) => {
      p.innerHTML = original.get(p) ?? p.innerHTML;
      if (!MOBILE.matches) return;

      // Cortes de renglón naturales (los mismos con o sin justificar)
      p.style.textAlign = 'left';
      const words = wordsOf(p);
      const lines: Word[][] = [];
      words.forEach((w) => {
        const last = lines[lines.length - 1];
        if (last && Math.abs(last[0].rect.top - w.rect.top) < w.rect.height / 2) last.push(w);
        else lines.push([w]);
      });
      const width = p.clientWidth;
      const maxExtra = MAX_EXTRA_EM * parseFloat(getComputedStyle(p).fontSize);
      const left = p.getBoundingClientRect().left;

      // Renglones flojos (todos menos el último): se cortan con <br>, de atrás para adelante
      const loose = lines.slice(0, -1).filter((line) => {
        if (line.length < 2) return true;
        const used = line[line.length - 1].rect.right - left;
        return (width - used) / (line.length - 1) > maxExtra;
      });
      loose.reverse().forEach((line) => {
        const lastWord = line[line.length - 1];
        const rest = lastWord.node.splitText(lastWord.end);
        rest.parentNode!.insertBefore(document.createElement('br'), rest);
      });
      p.style.textAlign = '';
    });
  };

  let timer: number | undefined;
  const schedule = () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(balance, 120);
  };
  document.fonts.ready.then(balance);
  window.addEventListener('resize', schedule);
  MOBILE.addEventListener('change', balance);
</script>

<style>
  .hero {
    padding: 2rem 0 5rem;
    scroll-margin-top: 80px;
  }

  /* Entre bloques, el mismo espacio que hay entre secciones del sitio (medido: 160px escritorio, 144px celular) */
  .hero-blocks {
    display: grid;
    gap: 10rem;
  }

  /* Texto a la izquierda y foto a la derecha; en los bloques pares, al revés (zigzag) */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
  }

  .hero-grid--reverse {
    grid-template-columns: 0.95fr 1.05fr;
  }

  .hero-grid--reverse .hero-card {
    order: -1;
  }

  .hero-content {
    max-width: 640px;
  }

  /* Mismo tamaño que un h2 global: el título se achicó a propósito */
  .hero-title {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 3vw, 3.2rem);
    text-align: center;
  }

  /* Texto en una tarjeta, con la franja arcoíris de los colores del logo */
  .hero-description {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  /* Justificado sin guiones (los guiones de corte de palabra se descartaron por estética);
     text-wrap: pretty evita una palabra sola en el último renglón */
  .hero-description p {
    margin: 0;
    text-align: justify;
    hyphens: manual;
    text-wrap: pretty;
  }

  .hero-description p + p {
    margin-top: 0.85rem;
  }

  .hero-description :global(strong) {
    font-weight: 700;
  }

  .hero-description::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: var(--gradient-rainbow);
  }

  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    height: min(60vh, 520px);
    min-height: 320px;
  }

  .hero-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      padding-top: 2rem;
    }

    .hero-grid,
    .hero-grid--reverse {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* Título → foto → texto en cada bloque: el bloque de texto se "abre" para intercalar la foto */
    .hero-content {
      display: contents;
    }

    .hero-title {
      order: 1;
      margin: 0;
    }

    .hero-card,
    .hero-grid--reverse .hero-card {
      order: 2;
      height: 42vh;
      min-height: 280px;
    }

    .hero-description {
      order: 3;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 3rem 0 4rem;
    }

    .hero-blocks {
      gap: 9rem;
    }


    .hero-description {
      padding: 1.5rem 1.25rem 1.25rem;
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero-card,
    .hero-grid--reverse .hero-card {
      height: 36vh;
      min-height: 240px;
      border-radius: 22px;
    }
  }
</style>
