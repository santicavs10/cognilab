---
import { siteConfig } from '../data/site';
import Eyebrow from './Eyebrow.astro';
---

<section class="section" id="contacto">
  <div class="container contact-grid">
    <div class="contact-info" data-reveal>
      <Eyebrow label="Contactanos" />
      <h2>Dejanos tu consulta</h2>
      <p>
        Podés escribirnos para consultas, disponibilidad de turnos o más información sobre nuestros servicios.
      </p>

      <ul class="contact-list">
        <li><strong>WhatsApp:</strong> <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noreferrer">{siteConfig.phone}</a></li>
        <li><strong>Correo:</strong> <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
        <li><strong>Dirección:</strong> <a href={siteConfig.maps} target="_blank" rel="noreferrer">{siteConfig.address}</a></li>
      </ul>

      <div class="map-wrapper">
        <iframe
          src="https://maps.google.com/maps?q=Av+Juramento+2017+Belgrano+Buenos+Aires&output=embed"
          title="Ubicación en Google Maps"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a
          href={siteConfig.maps}
          target="_blank"
          rel="noreferrer"
          class="map-overlay"
          aria-label="Ver en Google Maps"
        ></a>
      </div>
    </div>

    <div class="contact-card" data-reveal>
      <!-- Formulario -->
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <!-- Clave pública de Web3Forms de CogniLab: las consultas llegan a equipo.cognilab@gmail.com -->
        <input type="hidden" name="access_key" value="cafda460-abad-4db8-a279-6af2c28564b6" />
        <input type="hidden" name="subject" value="Nueva consulta desde CogniLab" />
        <input type="hidden" name="from_name" value="CogniLab Web" />

        <label>
          Nombre
          <input type="text" name="nombre" placeholder="Tu nombre" autocomplete="name" required />
        </label>
        <label>
          Correo electrónico
          <input type="email" name="email" placeholder="Ej: nombre@gmail.com" autocomplete="email" required />
        </label>
        <label>
          Celular
          <input type="tel" id="telefono" name="telefono" placeholder="Ej: 11 2345-6789" autocomplete="tel" inputmode="tel" required />
        </label>
        <label>
          Mensaje
          <textarea name="mensaje" rows="4" placeholder="Contanos tu consulta" required></textarea>
        </label>
        <button class="btn btn-primary" type="submit" id="submit-btn">
          Enviar consulta
        </button>
      </form>

      <!-- Notificación de éxito -->
      <div id="success-msg" class="success-msg" aria-live="polite" hidden>
        <div class="success-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </div>
        <h3>¡Mensaje enviado!</h3>
        <p>Gracias por contactarnos. En breve nos estaremos comunicando con vos.</p>
      </div>

      <!-- Notificación de error -->
      <div id="error-msg" class="error-msg" aria-live="polite" hidden>
        <p>Hubo un problema al enviar tu mensaje. Por favor intentá de nuevo o escribinos por WhatsApp.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // ¿Parece un número de celular real? Sigue el plan de numeración argentino: el número
  // nacional tiene siempre 10 dígitos (código de área + número) y el área empieza con 1, 2 o 3.
  // Acepta las formas habituales: +54 9 11 3444-5533, 54 9 ..., 911 3444 5533, 011 15 3444-5533,
  // 11 3444 5533, 15 3444 5533 (sin código de área) y números de otros países con +.
  // No distingue celular de fijo (en Argentina comparten formato); detecta dígitos de más o de menos.
  function isValidPhone(raw) {
    const international = /^\s*(\+|00)/.test(raw);
    let d = raw.replace(/\D/g, '');
    if (raw.trim().startsWith('00')) d = d.slice(2);
    if (international && !d.startsWith('54')) return d.length >= 8 && d.length <= 15;
    if (d.startsWith('54') && (international || d.length >= 12)) d = d.slice(2);
    if (d.startsWith('0')) d = d.slice(1);
    if (d.startsWith('9') && (d.length === 11 || d.length === 13)) d = d.slice(1);
    // Local con 15 y sin código de área: 15 + 6 a 8 dígitos
    if (/^15[2-9]\d{5,7}$/.test(d)) return true;
    // Código de área (2 a 4 dígitos) + 15 + número: se quita el 15
    if (d.length === 12) {
      const sinQuince = [2, 3, 4].map((n) => (d.slice(n, n + 2) === '15' ? d.slice(0, n) + d.slice(n + 2) : '')).find(Boolean);
      if (sinQuince) d = sinQuince;
    }
    if (d.length !== 10) return false;
    // Área 11 (AMBA): el número no empieza con 0 ni 1. Las demás áreas empiezan con 2 o 3.
    return /^11[2-9]/.test(d) || /^[23]/.test(d);
  }

  const telefonoInput = document.getElementById('telefono');
  const checkPhone = () =>
    telefonoInput.setCustomValidity(
      !telefonoInput.value.trim() || isValidPhone(telefonoInput.value)
        ? ''
        : 'Revisá el número: parece que le falta o le sobra algún dígito. Ej: 11 3444-5533 o +54 9 11 3444-5533.'
    );
  telefonoInput.addEventListener('input', () => {
    telefonoInput.value = telefonoInput.value.replace(/[^\d\+\s\-\(\)\.]/g, '');
    checkPhone();
  });

  // Un campo con solo espacios no cuenta como completo
  const textFields = document.querySelectorAll('#contact-form input[type="text"], #contact-form textarea');
  textFields.forEach((field) =>
    field.addEventListener('input', () =>
      field.setCustomValidity(field.value && !field.value.trim() ? 'Completá este campo.' : '')
    )
  );

  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('success-msg');
  const errorMsg = document.getElementById('error-msg');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    errorMsg.hidden = true;

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();

      if (data.success) {
        form.hidden = true;
        successMsg.hidden = false;
      } else {
        throw new Error('Error en el envío');
      }
    } catch {
      errorMsg.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar consulta';
    }
  });
</script>

<style>
  [hidden] { display: none !important; }

  #contacto {
    scroll-margin-top: 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: center;
  }

  .contact-info :global(.eyebrow) {
    display: flex;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  /* Título centrado, como el resto de los títulos de sección */
  .contact-info h2 {
    text-align: center;
  }

  .contact-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
  }

  form label {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font: inherit;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-focus-ring);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .map-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    height: 160px;
  }

  .map-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.9rem 1.3rem;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
  }

  .btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  /* ─── Éxito ───────────────────────────────────────────── */
  .success-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    gap: 0.75rem;
    min-height: 280px;
  }

  .success-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .success-msg h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.4rem;
  }

  .success-msg p {
    margin: 0;
    color: var(--color-muted);
    max-width: 30ch;
  }

  /* ─── Error ───────────────────────────────────────────── */
  .error-msg {
    margin-top: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: var(--color-error-bg);
    color: var(--color-red);
    font-size: 0.95rem;
    text-align: center;
  }

  .error-msg p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
