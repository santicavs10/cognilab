---
import { professionals } from '../data/site';
import InfoDialog from './InfoDialog.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Professional = (typeof professionals)[number];

// "María José Carnelli" -> "maria-jose-carnelli" (id de su ventana)
const slug = (name: string) =>
  name.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, '-');
const bioOf = (p: Professional) => (p as { bio?: string[] }).bio ?? [];
const positionOf = (p: Professional) => (p as { position?: string }).position ?? '';
const titleOf = (p: Professional) => (p as { title?: string }).title ?? '';
const firstName = (name: string) => name.split(' ')[0];
// Cada ítem de la bio se muestra terminado en punto
const withPeriod = (item: string) => (item.endsWith('.') ? item : `${item}.`);

// Áreas en orden de aparición; cada profesional va al área de su rol.
// El color del área es el mismo de su tarjeta en "Nuestras especialidades".
const areas = [
  { title: 'Psicopedagogía', role: 'Psicopedagoga', accent: 'var(--color-secondary-strong)' },
  { title: 'Psicología', role: 'Psicóloga', accent: 'var(--color-primary)' }
];

// Anillos: los 8 colores del logo en el orden de sus letras (c-o-g-n-i-L-a-b)
const accents = [
  'var(--color-red)',
  'var(--color-orange)',
  'var(--color-accent)',
  'var(--color-green)',
  'var(--color-secondary)',
  'var(--color-secondary-strong)',
  'var(--color-purple)',
  'var(--color-pink)'
];

// Grupos en orden: primero cada cargo (por ejemplo, "Directora"), con su propio color; después cada área
const positions = [...new Set(professionals.map(positionOf).filter(Boolean))];
const groups = [
  ...positions.map((position) => ({
    title: position,
    accent: 'var(--color-purple)',
    members: professionals.filter((p) => positionOf(p) === position)
  })),
  ...areas.map((area) => ({
    ...area,
    members: professionals.filter((p) => p.role === area.role && !positionOf(p))
  }))
];

// Colores en el orden en que se ven, así nunca se repiten seguidos
const ordered = groups.flatMap((g) => g.members).map((p, i) => ({ ...p, accent: accents[i % accents.length] }));
const accentOf = (p: Professional) => ordered.find((o) => o.name === p.name)?.accent ?? accents[0];
---

<section class="section section--alt" id="profesionales">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <h2 class="section-title">Nuestro equipo</h2>
    </div>

    {groups.filter((g) => g.members.length).map((group) => (
    <div class="team-area" style={group.accent ? `--area: ${group.accent}` : undefined}>
    {group.title && <h3 class="team-area__title" data-reveal>{group.title}</h3>}
    <ul class="team-list">
      {group.members.map((professional) => (
        <li class="team-member" style={`--accent: ${accentOf(professional)}`} data-reveal>
          <div class="team-photo">
            <img
              src={`${base}${professional.image}`}
              alt={`Foto de ${professional.name}`}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="team-info">
            <h4>{professional.name}</h4>
            {titleOf(professional) && <p class="role">{titleOf(professional)}</p>}
            <button
              class="team-more"
              type="button"
              data-dialog-open={`profesional-${slug(professional.name)}`}
              aria-haspopup="dialog"
            >
              Conocé más<span class="visually-hidden"> sobre {professional.name}</span>
              <span class="team-more__arrow" aria-hidden="true">→</span>
            </button>
          </div>
        </li>
      ))}
    </ul>
    </div>
    ))}
  </div>

  {ordered.map((professional) => (
    <InfoDialog
      id={`profesional-${slug(professional.name)}`}
      labelledby={`profesional-${slug(professional.name)}-nombre`}
      accent={professional.accent}
    >
      <div class="bio-header">
        <div class="team-photo team-photo--dialog">
          <img src={`${base}${professional.image}`} alt="" width="600" height="600" loading="lazy" decoding="async" />
        </div>
        <div>
          <h2 class="bio-name" id={`profesional-${slug(professional.name)}-nombre`}>{professional.name}</h2>
          {titleOf(professional) && <p class="bio-role">{titleOf(professional)}</p>}
        </div>
      </div>
      {bioOf(professional).length
        ? <ul class="bio-list">{bioOf(professional).map((item) => <li>{withPeriod(item)}</li>)}</ul>
        : <p class="bio-text bio-text--pending">La presentación de {firstName(professional.name)} estará disponible próximamente.</p>}
    </InfoDialog>
  ))}
</section>

<script>
  // Marca a la persona cuya foto cruza la franja central de la pantalla
  const photos = document.querySelectorAll<HTMLElement>('.team-photo');
  if (photos.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => e.target.closest('.team-member')?.classList.toggle('is-centered', e.isIntersecting)),
      { rootMargin: '-45% 0px -45% 0px' }
    );
    photos.forEach((p) => observer.observe(p));
  }
</script>

<style>
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  /* Una persona por fila en todos los tamaños (prueba; la grilla de 3 por fila es el commit ea42397) */
  .team-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem 2rem;
    max-width: 66rem;
    margin: 1rem auto 0;
    padding: 0;
    list-style: none;
  }

  /* Cada persona: foto centrada y, debajo, nombre y rol */
  .team-member {
    flex: 0 1 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  /* Foto circular con borde blanco y un anillo fino del color de la marca */
  .team-photo {
    width: 15rem;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: var(--color-surface);
    box-shadow: 0 0 0 3px var(--accent), var(--shadow-soft);
    overflow: hidden;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* La foto se agranda al quedar en el centro de la pantalla (y con el mouse encima, si hay mouse) */
  .team-member.is-centered .team-photo img {
    transform: scale(1.06);
  }

  @media (hover: hover) {
    .team-member:hover .team-photo img {
      transform: scale(1.06);
    }
  }

  /* ─── Áreas: subtítulo centrado con una línea del color del área ─── */
  .team-area + .team-area {
    margin-top: 4.5rem;
  }

  .team-area__title {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 40rem;
    margin: 0 auto 2.25rem;
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    color: var(--color-text);
  }

  .team-area__title::before,
  .team-area__title::after {
    content: '';
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--area));
  }

  .team-area__title::after {
    background: linear-gradient(90deg, var(--area), transparent);
  }

  /* h4 no tiene estilo global de título: se le da el mismo que a los nombres antes */
  .team-info h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text);
  }

  .role {
    margin: 0.3rem 0 0;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  /* "Conocé más": enlace discreto, más chico que el rol, subrayado fino */
  .team-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    /* El relleno vertical cuenta como separación: queda a la misma distancia del rol que el rol del nombre */
    margin-top: 0.1rem;
    padding: 0.2rem 0.1rem;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .team-more__arrow {
    display: inline-block;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .team-more:hover,
  .team-more:active,
  .team-more:focus-visible {
    color: var(--color-text);
    text-decoration-color: var(--accent);
  }

  .team-more:hover .team-more__arrow,
  .team-more:active .team-more__arrow {
    transform: translateX(3px);
  }

  .team-more:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ─── Contenido de la ventana de cada profesional (la ventana es InfoDialog) ─── */
  .bio-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0 3rem 1.5rem 0;
  }

  .team-photo.team-photo--dialog {
    flex-shrink: 0;
    width: 7.5rem;
    padding: 4px;
    box-shadow: 0 0 0 3px var(--accent);
  }

  .bio-name {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    color: var(--color-text);
  }

  .bio-role {
    margin: 0.3rem 0 0;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .bio-text {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .bio-text--pending {
    font-style: italic;
  }

  /* Formación y experiencia: lista con viñetas del color de la persona */
  .bio-list {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    background: rgba(102, 12, 159, 0.04);
    list-style: none;
    text-align: left;
  }

  .bio-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .bio-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Celular: una persona por fila, foto grande ─── */
  @media (max-width: 600px) {
    .team-list {
      gap: 2.75rem;
    }

    .team-member {
      flex-basis: 100%;
    }

    .team-photo {
      width: min(80vw, 20rem);
    }

    .team-info h4 {
      font-size: 1.5rem;
    }

    .team-area + .team-area {
      margin-top: 3.5rem;
    }

    .role {
      font-size: 1.05rem;
    }

    /* En la ventana: foto arriba y nombre/rol centrados debajo */
    .bio-header {
      flex-direction: column;
      margin: 0.5rem 0 1.25rem;
      text-align: center;
    }

    .bio-text {
      text-align: center;
    }

    .bio-list {
      padding: 1rem 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo img {
      transition: none;
    }
  }
</style>
