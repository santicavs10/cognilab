---
import { professionals } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Anillo de cada foto con un color de la marca, en orden
const accents = [
  'var(--color-primary)',
  'var(--color-secondary-strong)',
  'var(--color-purple)',
  'var(--color-pink)',
  'var(--color-orange)'
];
---

<section class="section section--alt" id="profesionales">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <h2 class="section-title">Nuestro equipo</h2>
    </div>

    <ul class="team-list">
      {professionals.map((professional, i) => (
        <li class="team-member" style={`--accent: ${accents[i % accents.length]}`} data-reveal>
          <div class="team-photo">
            <img
              src={`${base}${professional.image}`}
              alt={`Foto de ${professional.name}`}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="team-info">
            <p class="role">{professional.role}</p>
            <h3>{professional.name}</h3>
            <p class="bio">{professional.bio}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  .team-list {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .team-member {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    align-items: center;
    gap: 2.25rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .team-member:last-child {
    border-bottom: none;
  }

  /* Foto circular con borde blanco y un anillo fino del color de la marca */
  .team-photo {
    width: 10.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 5px;
    background: var(--color-surface);
    box-shadow: 0 0 0 3px var(--accent), var(--shadow-soft);
    overflow: hidden;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .team-member:hover .team-photo img {
    transform: scale(1.04);
  }

  .team-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .role {
    align-self: flex-start;
    margin: 0;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, white);
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .team-info h3 {
    margin: 0;
    font-size: 1.45rem;
    color: var(--color-text);
  }

  .bio {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 600px) {
    .team-member {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.25rem;
      padding: 1.75rem 0;
      text-align: center;
    }

    .team-photo {
      width: 8.75rem;
    }

    .role {
      align-self: center;
    }

    .team-info h3 {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo img {
      transition: none;
    }
  }
</style>
