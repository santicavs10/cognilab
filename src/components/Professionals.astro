---
import { professionals } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Anillo de cada foto con un color de la marca, en orden
const accents = [
  'var(--color-primary)',
  'var(--color-secondary-strong)',
  'var(--color-purple)',
  'var(--color-pink)',
  'var(--color-orange)'
];
---

<section class="section section--alt" id="profesionales">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <h2 class="section-title">Nuestro equipo</h2>
    </div>

    <ul class="team-list">
      {professionals.map((professional, i) => (
        <li class="team-member" style={`--accent: ${accents[i % accents.length]}`} data-reveal>
          <div class="team-photo">
            <img
              src={`${base}${professional.image}`}
              alt={`Foto de ${professional.name}`}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="team-info">
            <h3>{professional.name}</h3>
            <p class="role">{professional.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Marca a la persona cuya foto cruza la franja central de la pantalla
  const photos = document.querySelectorAll<HTMLElement>('.team-photo');
  if (photos.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => e.target.closest('.team-member')?.classList.toggle('is-centered', e.isIntersecting)),
      { rootMargin: '-45% 0px -45% 0px' }
    );
    photos.forEach((p) => observer.observe(p));
  }
</script>

<style>
  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  /* Grilla: 3 por fila en escritorio, 2 en tablet, 1 en celular; la última fila queda centrada */
  .team-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3rem 2rem;
    max-width: 66rem;
    margin: 1rem auto 0;
    padding: 0;
    list-style: none;
  }

  /* Cada persona: foto centrada y, debajo, nombre y rol */
  .team-member {
    flex: 0 1 19rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  /* Foto circular con borde blanco y un anillo fino del color de la marca */
  .team-photo {
    width: 15rem;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: var(--color-surface);
    box-shadow: 0 0 0 3px var(--accent), var(--shadow-soft);
    overflow: hidden;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* La foto se agranda al quedar en el centro de la pantalla (y con el mouse encima, si hay mouse) */
  .team-member.is-centered .team-photo img {
    transform: scale(1.06);
  }

  @media (hover: hover) {
    .team-member:hover .team-photo img {
      transform: scale(1.06);
    }
  }

  .team-info h3 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--color-text);
  }

  .role {
    margin: 0.3rem 0 0;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  /* ─── Celular: una persona por fila, foto grande ─── */
  @media (max-width: 600px) {
    .team-list {
      gap: 2.75rem;
    }

    .team-member {
      flex-basis: 100%;
    }

    .team-photo {
      width: min(80vw, 20rem);
    }

    .team-info h3 {
      font-size: 1.5rem;
    }

    .role {
      font-size: 1.05rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo img {
      transition: none;
    }
  }
</style>
