---
import { gallery } from '../data/site';
import Eyebrow from './Eyebrow.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const small = (src: string) => src.replace(/\.jpg$/, '-800.jpg');

// Copias de la última y la primera foto en los extremos para que el carrusel sea continuo
const slides = [
  { ...gallery[gallery.length - 1], clone: true, index: gallery.length - 1 },
  ...gallery.map((image, index) => ({ ...image, clone: false, index })),
  { ...gallery[0], clone: true, index: 0 }
];
---

<section class="section section--alt" id="espacio">
  <div class="container">
    <div class="section-heading section-heading--center">
      <Eyebrow label="Nuestro espacio" />
      <h2>Conocé nuestro espacio de trabajo</h2>
    </div>

    <div
      class="carousel"
      id="gallery-carousel"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Fotos de nuestro espacio"
    >
      <div class="carousel-viewport">
        <ul class="carousel-track" id="gallery-track">
          {slides.map((image) => (
            <li
              class:list={['carousel-slide', { 'is-active': !image.clone && image.index === 0 }]}
              role={image.clone ? undefined : 'group'}
              aria-roledescription={image.clone ? undefined : 'foto'}
              aria-label={image.clone ? undefined : `${image.index + 1} de ${gallery.length}`}
              aria-hidden={image.clone ? 'true' : undefined}
            >
              <img
                src={`${base}${image.src}`}
                srcset={`${base}${small(image.src)} 800w, ${base}${image.src} 1600w`}
                sizes="(max-width: 600px) 88vw, min(78vw, 880px)"
                width="1600"
                height="1067"
                alt={image.clone ? '' : image.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </li>
          ))}
        </ul>

        <button class="carousel-arrow carousel-arrow--prev" type="button" aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="carousel-arrow carousel-arrow--next" type="button" aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>

      <div class="carousel-dots">
        {gallery.map((_, i) => (
          <button
            class:list={['dot', { 'dot--active': i === 0 }]}
            type="button"
            data-index={i}
            aria-label={`Ver foto ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>

      <p class="visually-hidden" aria-live="polite" id="gallery-status"></p>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('gallery-carousel');
  const track = document.getElementById('gallery-track');
  const status = document.getElementById('gallery-status');

  if (root && track) {
    // Posiciones: 0 = copia de la última, 1..total = fotos reales, total + 1 = copia de la primera
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
    const total = slides.length - 2;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const prev = root.querySelector<HTMLButtonElement>('.carousel-arrow--prev');
    const next = root.querySelector<HTMLButtonElement>('.carousel-arrow--next');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const realIndex = (position: number) => (position - 1 + total) % total;
    let position = 1;
    let current = 0;
    let ticking = false;
    let settleTimer: number | undefined;

    const offsetFor = (p: number) => {
      const slide = slides[p];
      return slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2;
    };

    // Las fotos vecinas asoman a los costados: se cargan sin esperar al scroll
    const preloadAround = (p: number) => {
      [p - 1, p + 1].forEach((i) => {
        const img = slides[i]?.querySelector('img');
        if (img) img.loading = 'eager';
      });
    };

    const highlight = (p: number) => {
      slides.forEach((s, i) => s.classList.toggle('is-active', i === p));
    };

    const updateIndicators = (index: number) => {
      if (index === current) return;
      current = index;
      dots.forEach((d, i) => {
        d.classList.toggle('dot--active', i === index);
        if (i === index) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      if (status) status.textContent = `Foto ${index + 1} de ${total}`;
    };

    // La foto activa es la más cercana al centro del carrusel
    const nearestToCenter = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDistance = Infinity;
      slides.forEach((s, i) => {
        const distance = Math.abs(s.offsetLeft + s.offsetWidth / 2 - center);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      return best;
    };

    // Salto instantáneo y sin transiciones (de una copia a su foto real)
    const jumpTo = (p: number) => {
      track.classList.add('is-jumping');
      track.scrollTo({ left: offsetFor(p), behavior: 'instant' });
      position = p;
      highlight(p);
      preloadAround(p);
      void track.offsetWidth;
      track.classList.remove('is-jumping');
    };

    const goTo = (p: number) => {
      const target = Math.max(0, Math.min(p, slides.length - 1));
      track.scrollTo({ left: offsetFor(target), behavior: reduceMotion.matches ? 'instant' : 'smooth' });
    };

    // Al detenerse sobre una copia, se pasa a la foto real equivalente
    const settle = () => {
      const p = nearestToCenter();
      if (p === 0) jumpTo(total);
      else if (p === total + 1) jumpTo(1);
    };

    jumpTo(1);

    track.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            const p = nearestToCenter();
            if (p !== position) {
              position = p;
              highlight(p);
              preloadAround(p);
              updateIndicators(realIndex(p));
            }
            ticking = false;
          });
        }
        if (!('onscrollend' in window)) {
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(settle, 150);
        }
      },
      { passive: true }
    );
    track.addEventListener('scrollend', settle);

    window.addEventListener('resize', () => jumpTo(position === 0 ? total : position === total + 1 ? 1 : position));

    prev?.addEventListener('click', () => goTo(position - 1));
    next?.addEventListener('click', () => goTo(position + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i + 1)));

    // Tocar una foto vecina la trae al centro
    slides.forEach((s, i) => s.addEventListener('click', () => i !== position && goTo(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(position - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(position + 1);
      }
    });
  }
</script>

<style>
  .carousel {
    position: relative;
  }

  .carousel-viewport {
    position: relative;
  }

  /* ─── Pista con scroll-snap (swipe nativo en celular) ─── */
  .carousel-track {
    --slide-width: 78%;
    position: relative;
    display: flex;
    gap: 1.25rem;
    margin: -1rem 0 -1.5rem;
    padding: 1rem calc((100% - var(--slide-width)) / 2) 2.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* El padding de la pista deja el área interior en --slide-width */
  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    opacity: 0.45;
    transform: scale(0.92);
    transition:
      opacity 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    cursor: pointer;
  }

  .carousel-slide.is-active {
    opacity: 1;
    transform: none;
    cursor: default;
  }

  .carousel-track.is-jumping .carousel-slide {
    transition: none;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 5px solid var(--color-surface-badge);
    box-shadow: var(--shadow-soft);
    user-select: none;
  }

  /* ─── Flechas ────────────────────────────────────────── */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-top: -1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-ui);
    color: var(--color-text);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .carousel-arrow svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel-arrow--prev {
    left: calc(11% - 1.5rem);
  }

  .carousel-arrow--next {
    right: calc(11% - 1.5rem);
  }

  .carousel-arrow:hover {
    background: var(--color-primary);
    color: var(--color-surface);
    transform: scale(1.06);
  }

  .carousel-arrow:focus-visible,
  .dot:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* ─── Puntos ─────────────────────────────────────────── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.15rem;
    margin-top: 1.25rem;
  }

  /* Área táctil de 24px con un punto visual más chico */
  .dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: none;
    cursor: pointer;
    transition: width 0.3s ease;
  }

  .dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-border);
    box-shadow: inset 0 0 0 1px var(--color-border);
    transition: background 0.3s ease, width 0.3s ease;
  }

  .dot:hover::before {
    background: var(--color-muted);
  }

  .dot--active {
    width: 2rem;
  }

  .dot--active::before,
  .dot--active:hover::before {
    width: 1.4rem;
    background: var(--color-primary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Responsive ─────────────────────────────────────── */
  @media (max-width: 600px) {
    .carousel-track {
      --slide-width: 88%;
      gap: 0.75rem;
    }

    .carousel-slide {
      transform: scale(0.95);
    }

    .carousel-slide img {
      border-radius: var(--radius-md);
      border-width: 4px;
    }

    /* Puntos más angostos para que entren todos en pantallas chicas */
    .carousel-dots {
      flex-wrap: wrap;
      gap: 0;
    }

    .dot {
      width: 1.25rem;
    }

    .dot--active {
      width: 1.75rem;
    }

    .dot::before {
      width: 0.45rem;
      height: 0.45rem;
    }

    .dot--active::before,
    .dot--active:hover::before {
      width: 1.2rem;
    }

    /* En celular se navega deslizando y con los puntos */
    .carousel-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide,
    .carousel-arrow,
    .dot,
    .dot::before {
      transition: none;
    }
  }
</style>
